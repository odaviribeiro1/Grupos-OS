{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/bootstrap.ts": {
      "includeFiles": "supabase/**"
    },
    "api/redeploy-functions.ts": {
      "includeFiles": "supabase/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
